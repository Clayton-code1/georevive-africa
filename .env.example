# Copy this file to .env and fill in values. Never commit .env.

# Secret used to sign login tokens. setup.ps1 generates a random one for you.
GEOREVIVE_SECRET_KEY=change-me

# Demo user passwords (setup.ps1 generates random ones and prints them once).
GEOREVIVE_ADMIN_PASSWORD=
GEOREVIVE_GEOLOGIST_PASSWORD=
GEOREVIVE_ANALYST_PASSWORD=
GEOREVIVE_INVESTOR_PASSWORD=
GEOREVIVE_MINER_PASSWORD=

# Optional: NASA Earthdata login for ASTER (free account at https://urs.earthdata.nasa.gov/users/new)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Optional: LLM extraction mode (Anthropic Claude API key)
ANTHROPIC_API_KEY=

# Optional: Tesseract location if it is not on PATH
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
